{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "headers": [
    {
      "source": "/studio/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/emir-ucgun.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": { "eq": "studio.emirucgun.com" } }],
      "destination": "/studio/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/studio/:path*",
      "has": [{ "type": "host", "value": { "eq": "emirucgun.com" } }],
      "destination": "https://studio.emirucgun.com/:path*",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "has": [{ "type": "host", "value": { "eq": "www.emirucgun.com" } }],
      "destination": "https://studio.emirucgun.com/:path*",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/#profile",
      "permanent": false
    },
    {
      "source": "/work",
      "destination": "/#white-noise",
      "permanent": false
    },
    {
      "source": "/writing",
      "destination": "/#writing",
      "permanent": false
    }
  ]
}
